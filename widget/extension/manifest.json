{
  "manifest_version": 3,
  "name": "VerbaFlow Widget",
  "version": "0.2.1",
  "description": "Speak into any text box on a website. The text appears as you speak; you check it, then Accept.",
  "key": "",
  "permissions": [
    "storage",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "VerbaFlow Widget settings",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle-widget": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Start or stop speaking into the text box you are in"
    }
  }
}
